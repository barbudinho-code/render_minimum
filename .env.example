# Environment variables for the public posts application.
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# ==================== Server Configuration ====================
DJANGO_DEBUG=false
PUBLIC_BASE_URL=https://your-domain.com

# ==================== Database ====================
# For local development: comment out DATABASE_URL and use SQLite (default in settings.py).
# For production on Render, set this from the PostgreSQL database service.
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# ==================== Email Settings ====================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@local
MODERATOR_EMAIL=moderator@example.com

# SMTP settings (for production). Comment out for local development (console email).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true

# For Gmail, you may also need:
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ==================== Application Settings ====================
# Confirmation deadline in seconds (default: 60).
CONFIRMATION_DEADLINE_SECONDS=60

# Moderator token TTL in hours (default: 24).
MODERATOR_TOKEN_TTL_HOURS=24

# Temporary email block period in seconds (default: 600 = 10 minutes).
EMAIL_COOLDOWN_SECONDS=600

# AI classifier result for initial implementation.
AI_CLASSIFIER_RESULT_DOUBTFUL_FIRST=true

# ==================== Rate Limiting ====================
RATE_LIMIT_WINDOW=60
RATE_LIMIT_REQUESTS=3

# Task worker settings.
TASK_LEASE_SECONDS=300
TASK_MAX_ATTEMPTS=3
